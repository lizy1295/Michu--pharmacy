# Server
PORT=3001
NODE_ENV=development

# Database type: postgres (recommended) | sqlite
DB_TYPE=postgres
SQLITE_PATH=./data/michu-dev.sqlite

# PostgreSQL (used when DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=MPH

# JWT Authentication
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# ─── Chapa Payment Gateway ────────────────────────────────────────────────
# Get your secret key from: https://dashboard.chapa.co/settings/api-keys
# NEVER expose CHAPA_SECRET_KEY to the frontend or version-control.
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_BASE_URL=https://api.chapa.co
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_hash
# Backend public URL — used to build webhook callback_url for Chapa
API_BASE_URL=http://localhost:3001/api/v1

# ─── Ethiopian Mobile Money (Telebirr & CBE Birr) ──────────────────────────
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_SHORT_CODE=
TELEBIRR_API_URL=https://app.ethiomobilemoney.et:2121
CBE_MERCHANT_ID=
CBE_API_KEY=
CBE_API_URL=https://cbebirr.cbe.com.et

# ─── Mail & OTP Notifications ─────────────────────────────────────────────
# In local development: leave these empty and OTP codes will log to the console.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Michu Pharmacy" <noreply@michupharmacy.com>
FRONTEND_URL=http://localhost:3000
